# 复制为 TEST/.env 后填写本地值；不要提交真实凭据。
# docker compose 与后端 Settings 都会读取这个文件（后端通过 ../TEST/.env）。
POSTGRES_DB=sagtrag
POSTGRES_USER=sagtrag_owner
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432

RABBITMQ_DEFAULT_USER=sagtrag
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PASSWORD=change-me
REDIS_PORT=16379

OBJECT_STORE_PORT=8333
S3_ACCESS_KEY=sagtrag-demo
S3_SECRET_KEY=change-me

# DashScope（Embedding / 重排 / 生成 / ASR）
DASHSCOPE_API_KEY=sk-replace-with-dashscope-key

# 运行时数据库账号；执行迁移时用 owner 连接覆盖 DATABASE_URL。
DATABASE_URL=postgresql+asyncpg://sagtrag_app:change-me@127.0.0.1:55432/sagtrag
RABBITMQ_URL=amqp://sagtrag:change-me@127.0.0.1:5672/

# 首次启动时自动创建 admin 使用的初始密码；首次登录后台会强制修改。
ADMIN_BOOTSTRAP_PASSWORD=change-me-at-least-8-chars
