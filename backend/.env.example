# 复制为 backend/.env 后填写；此模板值不可用于真实环境。
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ISSUER=https://sagtrag.example.invalid
ADMIN_BOOTSTRAP_PASSWORD=replace-with-local-demo-bootstrap-password
WE_COM_CORP_ID=replace-with-corp-id
WE_COM_AGENT_ID=replace-with-agent-id
WE_COM_SECRET=replace-with-wecom-app-secret
WE_COM_TOKEN=replace-with-wecom-callback-token
WE_COM_ENCODING_AES_KEY=replace-with-43-character-base64-key
WE_COM_TENANT_ID=00000000-0000-4000-8000-000000000001

# Redis 与 S3 凭据从 ../TEST/.env 读取；只在需要时覆盖连接地址或桶名。
# REDIS_HOST=127.0.0.1
# REDIS_PORT=16379
# S3_ENDPOINT_URL=http://127.0.0.1:8333
# S3_REGION=us-east-1
# S3_BUCKET=sagtrag-documents

# Phase 3 模型与检索；共用 TEST/.env 的 DASHSCOPE_API_KEY。
# GENERATION_MODEL=qwen3.7-plus
# GENERATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RERANK_MODEL=qwen3-rerank
# RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# RAG_RECALL_LIMIT=30
# RAG_CONTEXT_LIMIT=5
# RAG_MIN_RELEVANCE=0.25
# RAG_MESSAGE_RETENTION_DAYS=7

# Phase 4 语音；仍共用 DASHSCOPE_API_KEY，音频只在内存中处理。
# ASR_MODEL=qwen3-asr-flash
# ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VOICE_MAX_BYTES=2097152
# VOICE_MAX_SECONDS=60

# 意图路由与闲聊；默认关闭，验收通过后再设 INTENT_ROUTING_ENABLED=true。
# 未设置 INTENT_MODEL / INTENT_BASE_URL / CHITCHAT_MODEL 时复用生成模型与地址。
# INTENT_ROUTING_ENABLED=false
# INTENT_MODEL=
# INTENT_BASE_URL=
# INTENT_TIMEOUT_SECONDS=3
# INTENT_RETRY=1
# INTENT_CONFIDENCE_THRESHOLD=0.65
# INTENT_RULES_VERSION=rules-v1
# INTENT_PROMPT_VERSION=prompt-v1
# CHITCHAT_MODEL=
# CHITCHAT_TIMEOUT_SECONDS=30
# CHITCHAT_MAX_TOKENS=512
# CHITCHAT_MAX_BYTES=1200
